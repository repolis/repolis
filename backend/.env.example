# --- LLM ---------------------------------------------------------------
# Any OpenAI-compatible endpoint. Ollama: http://localhost:11434/v1
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"

# LLM_MODEL_FAST answers closed-set questions: "which of these 3 structs does
# this function operate on?" and "name this group of symbols". Each call sends
# ~120 tokens and returns 3-40. A 1.5-3B model is enough and is several times
# faster than a large one; accuracy comes from the candidate list being
# AST-derived and every answer being verified against the AST afterwards.
LLM_MODEL_FAST="qwen2.5:1.5b"

# LLM_MODEL is used only for /api/explain, when a user clicks one building and
# asks for a description. Nothing in the render path waits on it, so this can
# be as large as the machine can run.
LLM_MODEL="hf.co/yuxinlu1/gemma-4-12B-agentic-fable5-composer2.5-v2-3.5x-tau2-GGUF:Q4_K_M"

# Ollama serialises requests unless OLLAMA_NUM_PARALLEL is set on the server,
# so raising this past 2 only helps if the server is configured for it.
LLM_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=90

# --- Server ------------------------------------------------------------
DB_PATH="./data/sqlite.db"
APP_ENV=development
LOG_LEVEL=info
# Required only when the frontend is not served through the Vite proxy.
# CORS_ORIGIN="https://repolis.example.com"
