# --- LLM ---------------------------------------------------------------
# Any OpenAI-compatible endpoint. llama.cpp (llama-server): http://localhost:8080/v1
# Model names are the llama-server preset/router ids, not Ollama tags.
LLM_BASE_URL="http://localhost:8080/v1"
LLM_API_KEY="llama.cpp"

# LLM_MODEL_FAST answers closed-set questions: "which of these 3 structs does
# this function operate on?" and "name this group of symbols". Each call sends
# ~120 tokens and returns 3-40. A 1.5-3B model is enough and is several times
# faster than a large one; accuracy comes from the candidate list being
# AST-derived and every answer being verified against the AST afterwards.
LLM_MODEL_FAST="qwen3.5-2b"

# LLM_MODEL is used only for /api/explain, when a user clicks one building and
# asks for a description. Nothing in the render path waits on it, so this can
# be as large as the machine can run.
LLM_MODEL="gemma4-12b"

# Sent as reasoning_effort on every call. Every task caps output at 16-220
# tokens, so a thinking model (qwen3.x, gemma4, gemini 3.x) left to think
# spends the whole budget reasoning and returns nothing; the backend then
# silently falls back to rule-based answers. llama-server needs "none" (it
# still thinks at "minimal"); gemini-3.5-flash-lite rejects "none", use "minimal".
# "default" sends nothing and lets the server decide.
# Google AI Studio: LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_REASONING_EFFORT=none

# Whether the fast model settles associations the rules could not. Measured
# on 47 hand-labelled residual cases (internal/llm/eval_test.go): rules alone
# 77%, qwen3.5-2b 43-51%, gemma4-12b 51%, gemini-3.5-flash-lite 81%. A model
# below the rules makes the city worse, so leave this off for local models.
LLM_ADJUDICATE=false

# llama-server serialises requests unless it runs with more slots (-np N, or
# `parallel = N` in its models preset), so raising this past 2 only helps if
# the server is configured for it.
LLM_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=90

# --- Server ------------------------------------------------------------
DB_PATH="./data/sqlite.db"
APP_ENV=development
LOG_LEVEL=info
# Required only when the frontend is not served through the Vite proxy.
# CORS_ORIGIN="https://repolis.example.com"
